{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mql.dev/schema/0.2/reference-fixtures.json",
  "title": "MQL RFC Reference Fixture Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "institution", "fixtures"],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "institution": { "$ref": "institution-schema-0.2.schema.json" },
    "fixtures": {
      "type": "array", "minItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["fixture_id", "patterns", "program", "catalog", "cases"],
        "properties": {
          "fixture_id": { "type": "string" }, "patterns": { "type": "array", "items": { "type": "string", "pattern": "^P([1-9]|1[0-9]|20)$" }, "uniqueItems": true },
          "program": { "$ref": "mql-ir-0.2.schema.json" }, "catalog": { "$ref": "catalog-0.2.schema.json" },
          "cases": {
            "type": "array", "minItems": 1,
            "items": { "type": "object", "additionalProperties": false, "required": ["transcript", "profile", "expected"],
              "properties": { "transcript": { "$ref": "transcript-0.2.schema.json" }, "profile": { "$ref": "profile-0.2.schema.json" }, "expected": { "$ref": "audit-evaluation-0.2.schema.json" } }
            }
          }
        }
      }
    }
  }
}
